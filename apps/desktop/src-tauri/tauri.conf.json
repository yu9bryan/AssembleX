{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AssembleX Studio",
  "version": "0.1.0",
  "identifier": "io.github.yu8bryan.assemblex-studio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5180",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AssembleX Studio",
        "width": 1480,
        "height": 940,
        "minWidth": 1080,
        "minHeight": 720,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "acceptFirstMouse": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "copyright": "Apache-2.0",
    "category": "DeveloperTool",
    "macOS": { "minimumSystemVersion": "11.0" }
  }
}
